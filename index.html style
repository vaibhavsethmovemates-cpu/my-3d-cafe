<script>

/* =========================
   3D WORLD
========================= */

let scene,camera,renderer,controls;

function init3D(){

scene=new THREE.Scene();
scene.background=new THREE.Color(0x030508);

camera=new THREE.PerspectiveCamera(
60,
window.innerWidth/window.innerHeight,
.1,
1000
);

camera.position.set(0,5,14);

renderer=new THREE.WebGLRenderer({
antialias:true,
alpha:false
});

renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
renderer.setSize(window.innerWidth,window.innerHeight);
document.getElementById("scene").appendChild(renderer.domElement);

controls=new THREE.OrbitControls(camera,renderer.domElement);
controls.enableDamping=true;
controls.dampingFactor=.06;
controls.minDistance=5;
controls.maxDistance=28;
controls.maxPolarAngle=Math.PI*.48;

/* LIGHTS */

const ambient=new THREE.AmbientLight(0xffffff,.7);
scene.add(ambient);

const blue=new THREE.PointLight(0x00d9ff,8,35);
blue.position.set(0,8,3);
scene.add(blue);

const warm=new THREE.PointLight(0xffaa55,7,25);
warm.position.set(-8,5,-5);
scene.add(warm);

/* FLOOR */

const floor=new THREE.Mesh(
new THREE.PlaneGeometry(50,50),
new THREE.MeshStandardMaterial({
color:0x15191d,
metalness:.5,
roughness:.45
})
);

floor.rotation.x=-Math.PI/2;
scene.add(floor);

/* TABLE */

function cube(x,y,z,sx,sy,sz,color){

const m=new THREE.Mesh(
new THREE.BoxGeometry(sx,sy,sz),
new THREE.MeshStandardMaterial({
color,
metalness:.25,
roughness:.35
})
);

m.position.set(x,y,z);
scene.add(m);
return m;
}

for(let x=-9;x<=9;x+=6){

cube(x,2,-5,3.5,.3,2,0x39271e);

cube(x-1.4,.9,-5, .25,2,.25,0x151515);
cube(x+1.4,.9,-5, .25,2,.25,0x151515);

}

/* COUNTER */

cube(0,1.5,-11,14,3,1.5,0x18252d);

/* BACK WALL */

cube(0,5,-13,30,10,.5,0x07131b);

/* ROBOT */

const robotBody=cube(0,2,-4,1.5,2,1.1,0x8feaff);

const head=cube(0,3.5,-4,1.4,1.1,1,0xddeff5);

const eye1=cube(-.3,3.55,-4.55,.16,.16,.05,0x00d9ff);
const eye2=cube(.3,3.55,-4.55,.16,.16,.05,0x00d9ff);

/* FAIRY LIGHTS */

for(let i=-10;i<=10;i+=2){

const bulb=new THREE.Mesh(
new THREE.SphereGeometry(.13,12,12),
new THREE.MeshBasicMaterial({color:0xffd27a})
);

bulb.position.set(i,6,-9);
scene.add(bulb);

const light=new THREE.PointLight(0xffb35c,1,4);
light.position.copy(bulb.position);
scene.add(light);

}

/* FLOATING HOLOGRAM */

const holo=new THREE.Mesh(
new THREE.TorusGeometry(2.5,.025,8,80),
new THREE.MeshBasicMaterial({color:0x00d9ff})
);

holo.position.set(0,4,-7);
holo.rotation.x=Math.PI/2;
scene.add(holo);

/* ANIMATION */

function animate(){

requestAnimationFrame(animate);

holo.rotation.z+=.003;

robotBody.position.y=2+Math.sin(Date.now()*.002)*.08;
head.position.y=3.5+Math.sin(Date.now()*.002)*.08;

controls.update();

renderer.render(scene,camera);

}

animate();

}

function moveCamera(x,z){
camera.position.x+=x;
camera.position.z+=z;
controls.target.x+=x;
controls.target.z+=z;
}

/* RESPONSIVE 3D */

function resize3D(){

if(!camera||!renderer)return;

camera.aspect=window.innerWidth/window.innerHeight;
camera.updateProjectionMatrix();

renderer.setSize(
window.innerWidth,
window.innerHeight
);

renderer.setPixelRatio(
Math.min(window.devicePixelRatio,2)
);

}

window.addEventListener("resize",resize3D);
window.addEventListener("orientationchange",resize3D);

init3D();

/* =========================
   ORDER SYSTEM
========================= */

function orderFood(food){

document.getElementById("orderStatus").innerHTML=
"👨‍🍳 Chef received your order for <b>"+food+
"</b> — preparing it now.";

alert(
