 Luxury AI Café • Interactive dining • Games • Digital experiences<br><br>
 © 2026 NEONVERSE. Concept website.
</footer>

<div class="modal" id="modal">
 <div class="modalbox"><button class="close" onclick="closeModal()">×</button><h2>Reserve your table</h2><p class="lead">Leave your name and our digital host will prepare the experience.</p><input id="bookName" style="width:100%;padding:14px;margin:20px 0;border-radius:12px;border:1px solid #24404d;background:#0b1821;color:white" placeholder="Your name"><button class="btn" onclick="book()">CONFIRM REQUEST</button><p id="bookMsg" style="margin-top:14px;color:var(--cyan)"></p></div>
</div>

<div class="modal" id="drawModal">
 <div class="modalbox"><button class="close" onclick="closeDraw()">×</button><h2>Virtual Pen</h2><p class="lead">Draw with mouse or finger.</p><canvas id="canvas" style="width:100%;height:320px;background:#fff;border-radius:15px;touch-action:none;margin-top:15px"></canvas><button class="btn" style="margin-top:12px" onclick="clearCanvas()">CLEAR</button></div>
</div>

<script>
function scrollToId(id){document.getElementById(id).scrollIntoView({behavior:"smooth"})}
function openModal(){document.getElementById("modal").classList.add("open")}
function closeModal(){document.getElementById("modal").classList.remove("open")}
function book(){let n=document.getElementById("bookName").value.trim();document.getElementById("bookMsg").textContent=n?"Request received for "+n+" — welcome to NEONVERSE.":"Please enter your name."}
function placeOrder(){let n=document.getElementById("name").value.trim()||"Guest";let item=document.getElementById("item").value;document.getElementById("orderMsg").textContent="✓ "+n+"'s "+item.split(" — ")[0]+" order has been sent to the virtual chef."}
function startChefGame(){let score=0;let s=document.getElementById("gameScore");s.innerHTML="Tap ingredients: <button onclick='scoreGame(this)'>🍞</button> <button onclick='scoreGame(this)'>🥬</button> <button onclick='scoreGame(this)'>🧀</button> <button onclick='scoreGame(this)'>🥩</button><br><b>Score: <span id='score'>0</span></b>"}
function scoreGame(){let x=document.getElementById("score");x.textContent=Number(x.textContent)+10}
function healthGame(){alert("Health Challenge: Choose water, vegetables, whole grains and balanced meals more often. Enjoy treats in moderation.")}
function sendAI(){let input=document.getElementById("chatInput"),q=input.value.trim();if(!q)return;let box=document.getElementById("messages");box.innerHTML+='<div class="bubble me">'+q.replace(/</g,"&lt;")+'</div>';let a="Try our Signature Coffee or Truffle Pasta. You can also play Chef Rush while you wait.";let l=q.toLowerCase();if(l.includes("game"))a="You can play Chef Rush, take the Health Challenge, or use the Virtual Pen.";if(l.includes("cafe")||l.includes("experience"))a="NEONVERSE combines luxury dining, robotics, interactive 3D visuals, games and an AI digital host.";if(l.includes("order"))a="Use the Quick Order section to send your selection directly to the virtual chef.";setTimeout(()=>{box.innerHTML+='<div class="bubble">'+a+'</div>';box.scrollTop=box.scrollHeight},350);input.value=""}
function openDraw(){document.getElementById("drawModal").classList.add("open");setTimeout(initCanvas,50)}
function closeDraw(){document.getElementById("drawModal").classList.remove("open")}
let ctx,drawing=false;
function initCanvas(){let c=document.getElementById("canvas"),r=c.getBoundingClientRect(),d=devicePixelRatio||1;c.width=r.width*d;c.height=r.height*d;ctx=c.getContext("2d");ctx.scale(d,d);ctx.lineWidth=3;ctx.lineCap="round";ctx.strokeStyle="#071018";let pos=e=>{let t=e.touches?e.touches[0]:e;return{x:t.clientX-r.left,y:t.clientY-r.top}};c.onpointerdown=e=>{drawing=true;let p=pos(e);ctx.beginPath();ctx.moveTo(p.x,p.y)};c.onpointermove=e=>{if(!drawing)return;let p=pos(e);ctx.lineTo(p.x,p.y);ctx.stroke()};c.onpointerup=()=>drawing=false;c.onpointerleave=()=>drawing=false}
function clearCanvas(){let c=document.getElementById("canvas");ctx.clearRect(0,0,c.width,c.height)}
window.addEventListener("resize",()=>{if(document.getElementById("drawModal").classList.contains("open"))initCanvas()});
</script>
</body>
</html>
