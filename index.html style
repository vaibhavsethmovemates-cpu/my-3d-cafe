<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>LUMIÈRE — Luxury 3D Café</title>

<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

<style>
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
font-family:Arial,Helvetica,sans-serif;
background:#05070b;
color:#fff;
overflow-x:hidden
}
a{text-decoration:none;color:inherit}
button{
border:0;
cursor:pointer;
font:inherit
}

/* NAV */
nav{
position:fixed;
top:14px;
left:50%;
transform:translateX(-50%);
width:min(1200px,94%);
height:64px;
z-index:100;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 22px;
border:1px solid rgba(255,255,255,.16);
border-radius:22px;
background:rgba(7,10,15,.72);
backdrop-filter:blur(18px);
box-shadow:0 10px 50px rgba(0,0,0,.4)
}
.logo{
font-size:21px;
font-weight:800;
letter-spacing:4px
}
.logo span{color:#62e6ff}
.navlinks{
display:flex;
gap:22px;
font-size:12px;
letter-spacing:1px;
color:#bbb
}
.navlinks a:hover{color:#fff}
.cta{
background:linear-gradient(135deg,#fff,#8feaff);
color:#061018;
padding:11px 18px;
border-radius:30px;
font-weight:800
}

/* HERO */
#hero{
min-height:100vh;
position:relative
}
#scene{
position:absolute;
inset:0;
z-index:0
}
.heroText{
position:absolute;
z-index:5;
left:6%;
top:24%;
max-width:650px;
pointer-events:none
}
.badge{
display:inline-block;
padding:8px 13px;
border:1px solid rgba(98,230,255,.5);
border-radius:30px;
font-size:11px;
letter-spacing:2px;
color:#7deaff;
background:rgba(0,200,255,.06)
}
.heroText h1{
font-size:clamp(48px,8vw,105px);
line-height:.86;
margin:22px 0;
letter-spacing:-5px
}
.heroText h1 span{
color:#62e6ff;
text-shadow:0 0 35px #00cfff
}
.heroText p{
max-width:550px;
color:#c3c8cf;
font-size:17px;
line-height:1.7
}
.heroButtons{
margin-top:25px;
display:flex;
gap:12px;
flex-wrap:wrap;
pointer-events:auto
}
.btn{
padding:14px 22px;
border-radius:30px;
background:#fff;
color:#071018;
font-weight:800
}
.btn.alt{
background:rgba(255,255,255,.06);
border:1px solid rgba(255,255,255,.2);
color:white
}
.controls{
position:absolute;
right:25px;
bottom:25px;
z-index:10;
display:flex;
gap:8px
}
.controls button{
width:48px;
height:48px;
border-radius:14px;
background:rgba(0,0,0,.55);
border:1px solid #18cfff;
color:#fff
}

/* SECTIONS */
section{
padding:110px 6%;
position:relative
}
.dark{background:#070b11}
.light{
background:#f6f7f4;
color:#101317
}
.sectionTitle{
max-width:800px;
margin-bottom:45px
}
.kicker{
font-size:11px;
letter-spacing:3px;
color:#10cfff;
font-weight:800
}
.sectionTitle h2{
font-size:clamp(38px,6vw,75px);
line-height:.95;
margin:15px 0
}
.sectionTitle p{
color:#89919b;
line-height:1.7;
max-width:650px
}

/* CARDS */
.grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:20px
}
.card{
border:1px solid rgba(255,255,255,.1);
border-radius:26px;
padding:28px;
background:linear-gradient(145deg,rgba(255,255,255,.08),rgba(255,255,255,.025));
min-height:210px;
transition:.3s;
position:relative;
overflow:hidden
}
.card:hover{
transform:translateY(-8px);
border-color:#27d9ff;
box-shadow:0 20px 60px rgba(0,200,255,.12)
}
.card .icon{
font-size:38px;
margin-bottom:20px
}
.card h3{font-size:23px;margin-bottom:10px}
.card p{color:#9ca5ae;line-height:1.6}

/* MENU */
.menuGrid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:18px
}
.food{
background:white;
border-radius:25px;
overflow:hidden;
box-shadow:0 15px 50px rgba(0,0,0,.08);
transition:.3s
}
.food:hover{transform:translateY(-7px)}
.foodPic{
height:170px;
display:grid;
place-items:center;
font-size:70px;
background:linear-gradient(135deg,#fff,#dff9ff)
}
.foodInfo{padding:20px}
.foodInfo h3{margin-bottom:7px}
.price{
font-weight:800;
font-size:20px;
margin:12px 0
}
.order{
width:100%;
padding:11px;
border-radius:15px;
background:#071018;
color:white
}

/* LIVE */
.live{
display:grid;
grid-template-columns:1.3fr .7fr;
gap:25px
}
.liveBox{
min-height:400px;
border-radius:30px;
background:
radial-gradient(circle at 50% 20%,rgba(0,220,255,.15),transparent 30%),
#080d14;
border:1px solid rgba(255,255,255,.1);
padding:30px;
position:relative;
overflow:hidden
}
.people{
position:absolute;
inset:100px 30px 30px
}
.person{
position:absolute;
font-size:45px;
animation:walk 7s linear infinite
}
.person:nth-child(1){top:20%;left:5%}
.person:nth-child(2){top:50%;left:30%;animation-delay:2s}
.person:nth-child(3){top:25%;left:60%;animation-delay:4s}
.person:nth-child(4){top:65%;left:80%;animation-delay:1s}
@keyframes walk{
0%{transform:translateX(-40px)}
50%{transform:translateX(100px)}
100%{transform:translateX(-40px)}
}
.stat{
display:grid;
place-items:center;
height:100%;
text-align:center
}
.stat strong{
font-size:90px;
color:#62e6ff;
text-shadow:0 0 30px #00cfff
}
.stat span{color:#999}

/* REVIEWS */
.review{
padding:25px;
border-radius:24px;
background:#fff;
box-shadow:0 10px 40px rgba(0,0,0,.07)
}
.stars{color:#00a9d4;letter-spacing:3px;margin-bottom:15px}

/* ROBOT */
.robotBox{
min-height:450px;
display:grid;
place-items:center;
background:
radial-gradient(circle,#173d4a,transparent 35%),
#050a0f;
border-radius:35px;
overflow:hidden;
border:1px solid rgba(0,220,255,.2)
}
.robot{
font-size:150px;
filter:drop-shadow(0 0 35px #00d9ff);
animation:robotFloat 3s ease-in-out infinite
}
@keyframes robotFloat{
50%{transform:translateY(-20px) rotate(2deg)}
}

/* AI */
.ai{
max-width:800px;
margin:auto;
padding:30px;
border-radius:30px;
background:#090e15;
border:1px solid rgba(0,220,255,.2)
}
.chat{
height:250px;
overflow:auto;
padding:15px
}
.msg{
padding:12px 15px;
border-radius:16px;
background:#111a24;
margin-bottom:10px;
line-height:1.5
}
.msg.bot{border-left:3px solid #00d9ff}
.aiInput{
display:flex;
gap:10px
}
.aiInput input{
flex:1;
padding:15px;
border-radius:15px;
border:1px solid #26323d;
background:#05080d;
color:white
}
.aiInput button{
padding:0 20px;
border-radius:15px;
background:#62e6ff
}

/* GAMES */
.gameGrid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:20px
}
.game{
padding:30px;
border-radius:28px;
background:#080d14;
border:1px solid rgba(255,255,255,.1)
}
.game button{
margin-top:18px;
padding:12px 18px;
border-radius:20px;
background:#62e6ff
}

/* DRAW */
#draw{
width:100%;
height:400px;
border-radius:25px;
background:#fff;
touch-action:none;
display:block
}
.drawControls{
margin-top:15px;
display:flex;
gap:10px;
flex-wrap:wrap
}

/* FOOTER */
footer{
padding:60px 6%;
background:#030508;
color:#77808a;
text-align:center
}

/* MOBILE */
@media(max-width:900px){
.navlinks{display:none}
nav{height:58px}
.heroText{
left:6%;
right:6%;
top:18%
}
.heroText h1{
letter-spacing:-3px
}
.grid,
.menuGrid,
.gameGrid{
grid-template-columns:1fr 1fr
}
.live{grid-template-columns:1fr}
section{padding:80px 5%}
}

@media(max-width:600px){
.heroText h1{font-size:55px}
.heroText p{font-size:14px}
.grid,
.menuGrid,
.gameGrid{
grid-template-columns:1fr
}
.heroButtons .btn{width:100%;text-align:center}
.controls{
bottom:15px;
right:15px
}
.controls button{
width:42px;
height:42px
}
.stat strong{font-size:65px}
.robot{font-size:100px}
section{padding:65px 5%}
.card{min-height:auto}
}
</style>
</head>

<body>

